      ,KSM_Salon_Event_spouse.KSM_Salon_Event as KSM_Salon_Event_spouse
      ,special_handling.spouse_service_indicators_concat
      ,special_handling.spouse_No_contact
      ,special_handling.spouse_NO_Mail_IND
      ,special_handling.spouse_NO_EMail_IND
      --,dean_salutation.Joint_Dean_Salut
      --,dean_salutation.Joint_Fullname
      --,employ.primary_job_title
      --,employ.primary_employer
      -- ranking column added for the tiebreaker (dropped from final output):
      ,row_number() over (
         partition by mv_entity.household_id_ksm
         order by case when mv_entity.donor_id in ('0000548536','0000887893','0000478896','0000240149') then 0 else 1 end
                , case when mv_entity.donor_id = '0000420000' then 1 else 0 end
                , case when lower(mv_entity.primary_record_type) = 'alum'   then 0
                       when lower(mv_entity.primary_record_type) = 'friend' then 1
                       else 2 end
                , mv_entity.donor_id
       ) as hh_rank
from mv_entity
left join assistants on assistants.primary_donor_id = mv_entity.donor_id
left join manual_adds on manual_adds.donor_id = mv_entity.donor_id
left join KSM_Salon_Event on KSM_Salon_Event.donor_id = mv_entity.donor_id
left join KSM_Salon_Event KSM_Salon_Event_spouse on KSM_Salon_Event_spouse.donor_id = mv_entity.spouse_donor_id
left join mv_entity mv_entity_spouse on mv_entity_spouse.donor_id = mv_entity.spouse_donor_id
left join GAB on GAB.donor_id = mv_entity.donor_id
left join GAB GAB_Spouse on GAB_Spouse.donor_id = mv_entity.spouse_donor_id
left join GAB_Former_FY26 on GAB_Former_FY26.donor_id = mv_entity.donor_id
left join GAB_Former_FY26 GAB_Former_FY26_Spouse on GAB_Former_FY26_Spouse.donor_id = mv_entity.spouse_donor_id
left join BOT_and_Alumni on BOT_and_Alumni.donor_id = mv_entity.donor_id
left join BOT_and_Alumni BOT_and_Alumni_Spouse on BOT_and_Alumni_Spouse.donor_id = mv_entity.spouse_donor_id
left join BOT_Non_Alumni on BOT_Non_Alumni.donor_id = mv_entity.donor_id
left join BOT_Non_Alumni BOT_Non_Alumni_Spouse on BOT_Non_Alumni_Spouse.donor_id = mv_entity.spouse_donor_id
left join KFC_Campaign_Member on KFC_Campaign_Member.donor_id = mv_entity.donor_id
left join KFC_Campaign_Member KFC_Campaign_Member_Spouse on KFC_Campaign_Member_Spouse.donor_id = mv_entity.spouse_donor_id
left join KSM_Cornerstone on KSM_Cornerstone.household_id = mv_entity.household_id_ksm
left join klc_50K_flags on klc_50K_flags.household_id = mv_entity.household_id_ksm
-- (unused in output/criteria; re-enable together with the proposal columns)
--left join expendable_fy26_proposal on expendable_fy26_proposal.household_id = mv_entity.household_id_ksm
left join email on email.ucinn_ascendv2__donor_id__c = mv_entity.donor_id
left join email email_spouse on email_spouse.ucinn_ascendv2__donor_id__c = mv_entity.spouse_donor_id
left join last_gift on last_gift.household_id = mv_entity.household_id_ksm
left join dean_salutation on dean_salutation.donor_id = mv_entity.donor_id
left join dean_salutation dean_salutation_spouse on dean_salutation_spouse.donor_id = mv_entity.spouse_donor_id
left join lagm_and_pm on lagm_and_pm.household_id = mv_entity.household_id_ksm
left join special_handling on special_handling.household_id = mv_entity.household_id_ksm
left join employ on employ.household_id = mv_entity.household_id_ksm
left join last_cr on last_cr.household_id = mv_entity.household_id_ksm
left join alt_florida_home on alt_florida_home.address_donor_id = mv_entity.donor_id
left join mv_entity_contact_info mvc on mvc.donor_id = mv_entity.donor_id
left join expendable_designations on expendable_designations.credited_donor_id = mv_entity.donor_id
left join mv_ksm_giving_summary on mv_ksm_giving_summary.donor_id = mv_entity.donor_id
-- primary hh (deduping households). The OR lets the forced-primary donor_ids in even
-- when they are flagged household_primary = 'N' (they are the spouse side today); the
-- row_number() float above then makes them the kept row and drops their partner.
where (mv_entity.household_primary = 'Y'
   or mv_entity.donor_id in ('0000887893','0000478896','0000240149'))   -- primary/spouse flip
and mv_entity.is_deceased_indicator = 'N' -- not deceased
and mv_entity.person_or_org = 'P' -- person
-- criteria
and (GAB.GAB = 'Y'
or GAB_Spouse.GAB = 'Y'
-- former GAB manual add (comment out these two lines to remove)
or GAB_Former_FY26.GAB_Former_FY26 = 'Y'
or GAB_Former_FY26_Spouse.GAB_Former_FY26 = 'Y'
or BOT_and_Alumni.BOT_and_Alumni = 'Y'
or BOT_and_Alumni_Spouse.BOT_and_Alumni = 'Y'
or KFC_Campaign_Member.KFC_Campaign_Member = 'Y'
or KFC_Campaign_Member_Spouse.KFC_Campaign_Member = 'Y'
--OR KSM_Cornerstone.Cornerstone_FY24 IN ('Donor_FY24','Member_FY24')
OR KSM_Cornerstone.Cornerstone_FY25 IN ('Donor_FY25','Member_FY25')
OR KSM_Cornerstone.Cornerstone_FY26 IN ('Donor_FY26','Member_FY26')
OR KSM_Cornerstone.Cornerstone_FY27 IN ('Donor_FY27','Member_FY27')
-- $50K+ expendable in any of FY25/FY26/FY27 (raw dollars; FY25=pfy2, FY26=pfy1, FY27=cfy)
or mv_ksm_giving_summary.expendable_pfy2 >= 50000
or mv_ksm_giving_summary.expendable_pfy1 >= 50000
or mv_ksm_giving_summary.expendable_cfy  >= 50000
--or klc_50K_flags.KLC_50K_FY24 = 'Y'
or klc_50K_flags.KLC_50K_FY25 = 'Y'
or klc_50K_flags.KLC_50K_FY26 = 'Y'
or klc_50K_flags.KLC_50K_FY27 = 'Y'
or KSM_Salon_Event.KSM_Salon_Event = 'Y'
or KSM_Salon_Event_spouse.KSM_Salon_Event = 'Y'
or manual_adds.manual_adds = 'Y'
--or expendable_fy26_proposal.fy26_expendable_proposal = 'Y'
)

) hh
where hh.hh_rank = 1
order by hh.last_name
