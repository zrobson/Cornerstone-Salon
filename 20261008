, last_cr as (
SELECT
    e.household_id
  , MAX(c.ucinn_ascendv2__date__c) AS last_cr_date
  , MAX(e.donor_id) KEEP (DENSE_RANK LAST ORDER BY c.ucinn_ascendv2__date__c, c.id) AS donor_id
  , MAX(c.ap_contact_report_author_name_formula__c) KEEP (DENSE_RANK LAST ORDER BY c.ucinn_ascendv2__date__c, c.id) AS last_cr_author
  , MAX(c.ucinn_ascendv2__description__c) KEEP (DENSE_RANK LAST ORDER BY c.ucinn_ascendv2__date__c, c.id) AS last_cr_description
  , MAX(c.ucinn_ascendv2__contact_method__c) KEEP (DENSE_RANK LAST ORDER BY c.ucinn_ascendv2__date__c, c.id) AS last_cr_type
FROM stg_alumni.ucinn_ascendv2__contact_report__c c
JOIN mv_entity e
  ON e.salesforce_id = c.ucinn_ascendv2__contact__c
GROUP BY e.household_id
)


