-- Cornerstone: FYxx Donor = gave $100K+ expendable in FYxx,
--              FYxx Member = gave $100K+ expendable in FYxx-1
-- Year mapping (FY27 is current): cfy=FY27, pfy1=FY26, pfy2=FY25, pfy3=FY24, pfy4=FY23
, KSM_Cornerstone As (
Select summ.household_id
     , summ.household_account_name
     , summ.ngc_lifetime
     , summ.expendable_cfy As Expendable_FY27
     , Case When summ.expendable_cfy >= '100000' Then 'Donor_FY27'
            When summ.expendable_pfy1 >= '100000' Then 'Member_FY27'
            End As Cornerstone_FY27
     , summ.expendable_pfy1 As Expendable_FY26
     , Case When summ.expendable_pfy1 >= '100000' Then 'Donor_FY26'
            When summ.expendable_pfy2 >= '100000' Then 'Member_FY26'
            End As Cornerstone_FY26
     , summ.expendable_pfy2 As Expendable_FY25
     , Case When summ.expendable_pfy2 >= '100000' Then 'Donor_FY25'
            When summ.expendable_pfy3 >= '100000' Then 'Member_FY25'
            End As Cornerstone_FY25
     , summ.expendable_pfy3 As Expendable_FY24
     , Case When summ.expendable_pfy3 >= '100000' Then 'Donor_FY24'
            When summ.expendable_pfy4 >= '100000' Then 'Member_FY24'
            End As Cornerstone_FY24
From mv_ksm_giving_summary summ
Where (summ.expendable_cfy >= '100000'
Or summ.expendable_pfy1 >= '100000'
Or summ.expendable_pfy2 >= '100000'
Or summ.expendable_pfy3 >= '100000'
Or summ.expendable_pfy4 >= '100000')
)

