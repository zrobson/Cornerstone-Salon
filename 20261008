, expendable_designations as (
SELECT
    credited_donor_id,
    LISTAGG(DISTINCT CASE WHEN fiscal_year = 2024 THEN designation_name END, ', ') 
        WITHIN GROUP (ORDER BY designation_name) AS all_expendable_designations_2024,
    LISTAGG(DISTINCT CASE WHEN fiscal_year = 2025 THEN designation_name END, ', ') 
        WITHIN GROUP (ORDER BY designation_name) AS all_expendable_designations_2025,
    LISTAGG(DISTINCT CASE WHEN fiscal_year = 2026 THEN designation_name END, ', ') 
        WITHIN GROUP (ORDER BY designation_name) AS all_expendable_designations_2026,
    LISTAGG(DISTINCT CASE WHEN fiscal_year = 2027 THEN designation_name END, ', ') 
        WITHIN GROUP (ORDER BY designation_name) AS all_expendable_designations_2027
FROM mv_ksm_transactions
WHERE cash_category = 'Expendable'
  AND fiscal_year IN (2024, 2025, 2026, 2027)
GROUP BY credited_donor_id
ORDER BY credited_donor_id
)

